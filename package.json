{
  "name": "fracture-monorepo",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "run": "npm run run:dev",
    "run:dev": "powershell -ExecutionPolicy Bypass -File ./scripts/run-fracture.ps1 -Mode dev",
    "build:release": "powershell -ExecutionPolicy Bypass -File ./apps/backend/scripts/build-backend.ps1 && npm --prefix apps/desktop run tauri:build",
    "run:prod": "powershell -ExecutionPolicy Bypass -File ./scripts/run-fracture.ps1 -Mode prod",
    "run:prod:build": "powershell -ExecutionPolicy Bypass -File ./scripts/run-fracture.ps1 -Mode prod -BuildIfMissing",
    "desktop:dev": "npm --prefix apps/desktop run dev",
    "desktop:build": "npm --prefix apps/desktop run build",
    "desktop:tauri:dev": "npm --prefix apps/desktop run tauri:dev",
    "desktop:tauri:build": "npm --prefix apps/desktop run tauri:build",
    "backend:dev": "python -m uvicorn app.main:app --reload --port 8765 --app-dir apps/backend",
    "backend:lint": "python -m ruff check apps/backend/app"
  }
}

